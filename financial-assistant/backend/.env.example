ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Free key: https://www.alphavantage.co/support/#api-key (takes ~20 seconds)
ALPHA_VANTAGE_API_KEY=your-alphavantage-key-here

# Free tier is heavily rate-limited (25 requests/day, 5/minute), so
# responses are cached in-memory for this many seconds.
CACHE_TTL_SECONDS=900
